<mujoco model="black_practice_field">
  <include file="black_description.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.05 0.08 0.12" width="512" height="3072"/>
    <texture name="field_checker" type="2d" builtin="checker" mark="edge"
             rgb1="0.25 0.32 0.38" rgb2="0.18 0.24 0.30" markrgb="0.55 0.60 0.65" width="300" height="300"/>
    <material name="field_ground" texture="field_checker" texuniform="true" texrepeat="2 2" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light name="field_sun" pos="0 0 5" dir="0 0 -1" directional="true"/>
    <!-- 地面保持原场景的 z=-0.1。box 的 size 是半尺寸，单位米。 -->
    <geom name="floor" type="plane" pos="0 0 -0.1" size="7 5 0.1" material="field_ground"/>

    <!-- 14×10 米场地边界，围栏高度 0.2 米。 -->
    <geom name="boundary_front" type="box" pos="7 0 0" size="0.04 5 0.1" rgba="0.7 0.75 0.8 1"/>
    <geom name="boundary_back" type="box" pos="-7 0 0" size="0.04 5 0.1" rgba="0.7 0.75 0.8 1"/>
    <geom name="boundary_left" type="box" pos="0 5 0" size="7 0.04 0.1" rgba="0.7 0.75 0.8 1"/>
    <geom name="boundary_right" type="box" pos="0 -5 0" size="7 0.04 0.1" rgba="0.7 0.75 0.8 1"/>

    <!-- 出生点周围留空。白色起点和通道标记只用于显示，不参与碰撞。 -->
    <geom name="start_line" type="box" pos="1 0 -0.098" size="0.025 1 0.002" rgba="1 1 1 1" contype="0" conaffinity="0"/>
    <geom name="lane_left" type="box" pos="3 0.9 -0.098" size="2 0.015 0.002" rgba="0.9 0.9 0.9 1" contype="0" conaffinity="0"/>
    <geom name="lane_right" type="box" pos="3 -0.9 -0.098" size="2 0.015 0.002" rgba="0.9 0.9 0.9 1" contype="0" conaffinity="0"/>

    <!-- 正前方：高度分别为 3、5、8 厘米的低横杆。 -->
    <geom name="bar_03" type="box" pos="2 0 -0.085" size="0.08 0.75 0.015" rgba="0.95 0.65 0.15 1"/>
    <geom name="bar_05" type="box" pos="3 0 -0.075" size="0.08 0.75 0.025" rgba="0.95 0.5 0.12 1"/>
    <geom name="bar_08" type="box" pos="4 0 -0.06" size="0.08 0.75 0.04" rgba="0.9 0.35 0.1 1"/>

    <!-- 左侧：每级升高 4 厘米，顶端高度 16 厘米。 -->
    <geom name="step_1" type="box" pos="2 2.5 -0.08" size="0.2 0.6 0.02" rgba="0.2 0.65 0.75 1"/>
    <geom name="step_2" type="box" pos="2.4 2.5 -0.06" size="0.2 0.6 0.04" rgba="0.2 0.6 0.7 1"/>
    <geom name="step_3" type="box" pos="2.8 2.5 -0.04" size="0.2 0.6 0.06" rgba="0.2 0.55 0.65 1"/>
    <geom name="step_4" type="box" pos="3.2 2.5 -0.02" size="0.2 0.6 0.08" rgba="0.2 0.5 0.6 1"/>
    <geom name="step_platform" type="box" pos="4 2.5 -0.02" size="0.6 0.6 0.08" rgba="0.15 0.45 0.55 1"/>

    <!-- 右侧：约 10 度上坡、平台和下坡，低端接近地面。 -->
    <geom name="ramp_up" type="box" pos="2.5 -2.5 0.01" size="0.75 0.6 0.02"
          quat="0.9961947 0 -0.0871557 0" rgba="0.3 0.65 0.3 1"/>
    <geom name="ramp_platform" type="box" pos="3.55 -2.5 0.03" size="0.3 0.6 0.13" rgba="0.25 0.55 0.25 1"/>
    <geom name="ramp_down" type="box" pos="4.6 -2.5 0.01" size="0.75 0.6 0.02"
          quat="0.9961947 0 0.0871557 0" rgba="0.3 0.65 0.3 1"/>

    <!-- 后方绕行区：三个固定路桩，用于测试横移和转向。 -->
    <geom name="slalom_1" type="cylinder" pos="-2 0.6 0.1" size="0.15 0.2" rgba="0.75 0.25 0.3 1"/>
    <geom name="slalom_2" type="cylinder" pos="-3 -0.6 0.1" size="0.15 0.2" rgba="0.75 0.25 0.3 1"/>
    <geom name="slalom_3" type="cylinder" pos="-4 0.6 0.1" size="0.15 0.2" rgba="0.75 0.25 0.3 1"/>
  </worldbody>
</mujoco>
